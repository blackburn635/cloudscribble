{
  "name": "@cloudscribble/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo start --dev-client --ios",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor && npx expo install --check",
    "build:ios:dev": "eas build --profile development --platform ios",
    "build:ios:preview": "eas build --profile preview --platform ios",
    "build:ios:prod": "eas build --profile production --platform ios",
    "submit:ios": "eas submit --platform ios"
  },
  "dependencies": {
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "amazon-cognito-identity-js": "^6.3.20",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.31",
    "expo-calendar": "~55.0.19",
    "expo-camera": "~55.0.23",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "nativewind": "4.2.1",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-css-interop": "0.2.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-purchases": "^10.12.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  }
}
